# ==============================================================================
# YATRAI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env (or server/.env) for local environment setup.
# Never commit actual credentials or production secrets to Git.
# ==============================================================================

# Server Core Configuration
NODE_ENV=development
PORT=5000
HOST=localhost
LOG_LEVEL=debug

# Client / CORS Configuration
CLIENT_URL=http://localhost:5173

# Frontend (Vite) Configuration
VITE_API_BASE_URL=http://localhost:5000/api

# Database — Phase 1 (MongoDB)
MONGODB_URI=mongodb://localhost:27017/yatrai_dev
DATABASE_URL=

# Cache — Phase 1 (Redis)
REDIS_URL=

# Authentication — Phase 2
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_NAME=yatrai_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Geocoding & Location Resolution — Phase 3
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=Yatrai-Platform/1.0
GEOCODING_TIMEOUT_MS=6000

# Transport Providers — Phase 5 (Rail, Bus, Flight, Road)
RAIL_API_KEY=
RAIL_API_URL=
BUS_API_KEY=
BUS_API_URL=
FLIGHT_API_KEY=
FLIGHT_API_URL=

# Maps & Geocoding — Phase 12
MAP_PROVIDER=
MAP_API_KEY=
