# ==============================================================================
# YATRAI SERVER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core Application
NODE_ENV=development
PORT=5000
HOST=localhost
LOG_LEVEL=debug

# Client & CORS
CLIENT_URL=http://localhost:5173

# Database — Phase 1 (MongoDB)
MONGODB_URI=mongodb://localhost:27017/yatrai_dev
DATABASE_URL=

# Cache — Phase 1
REDIS_URL=

# Authentication — Phase 2
JWT_SECRET=

# Transport Providers — Phase 5
RAIL_API_URL=https://api.railradar.in/v1
RAIL_API_KEY=
RAIL_TIMEOUT_MS=5000
RAIL_ENABLED=true

RAILRADAR_BASE_URL=https://api.railradar.in/v1
RAILRADAR_API_KEY=
RAILRADAR_TIMEOUT_MS=5000
RAILRADAR_ENABLED=true

# RailKit — Seat availability & fare provider (https://railkit.in)
# Auth: X-API-Key header. Dates are DD-MM-YYYY (auto-converted by adapter).
RAILKIT_API_KEY=
RAILKIT_API_URL=https://api.railkit.in
RAILKIT_TIMEOUT_MS=8000
RAILKIT_CACHE_TTL_MS=300000
RAILKIT_MAX_CONCURRENT=3
RAILKIT_MAX_ENRICH_CANDIDATES=5
RAILKIT_ENABLED=true
AOPAY_BASE_URL=https://api.aopay.in/v1
AOPAY_API_KEY=
AOPAY_TIMEOUT_MS=5000
AOPAY_ENABLED=false

BUS_API_URL=
BUS_API_KEY=
BUS_TIMEOUT_MS=5000
BUS_ENABLED=true

FLIGHT_API_URL=
FLIGHT_API_KEY=
FLIGHT_TIMEOUT_MS=5000
FLIGHT_ENABLED=true

ROAD_API_URL=https://router.project-osrm.org
ROAD_API_KEY=
ROAD_TIMEOUT_MS=5000
ROAD_ENABLED=true

# Maps & Geocoding
MAP_API_KEY=
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_TIMEOUT_MS=6000

